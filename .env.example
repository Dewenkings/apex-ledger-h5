# Public market data can optionally use a reachable OKX-compatible gateway.
# OKX_API_BASE_URL=https://openapi.okx.com

# Private trading is hard-locked to OKX official Demo Trading.
TRADING_PROFILE=okx_demo
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=

# Demo Trading access gate and signed HTTP-only session cookie.
DEMO_ACCESS_CODE=
SESSION_SECRET=

# Durable rate limits, idempotency records and per-session order ownership.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public browser configuration. These values are included in the browser bundle and are not secrets.
NEXT_PUBLIC_REOWN_PROJECT_ID=
# NEXT_PUBLIC_APP_URL=https://apex-ledger-h5.vercel.app
